# Security profile template, NOT consumed by the current precompiled Arduino SDK.
# Build in a controlled SDK; audit generated sdkconfig, not this input template.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
# External/HSM signer owns private material; unsigned inputs are reproduced first.
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n
CONFIG_BOOTLOADER_APP_SECURE_VERSION=0
# ESP-IDF 4.x controls. IDF 5+ should use CONFIG_APP_REPRODUCIBLE_BUILD=y.
CONFIG_APP_COMPILE_TIME_DATE=n
CONFIG_COMPILER_HIDE_PATHS_MACROS=y
CONFIG_SECURE_BOOT_ALLOW_JTAG=n
CONFIG_SECURE_BOOT_ALLOW_ROM_BASIC=n
CONFIG_SECURE_BOOT_INSECURE=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_DEC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE=n
